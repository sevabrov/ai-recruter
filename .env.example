# AI Recruiter — server-side environment (spec §22)
#
# Copy to `.env` and fill in. This file is read by docker compose and, from
# Phase 2, by the FastAPI backend. NONE of these values may be exposed to the
# browser: the front end only ever sees NEXT_PUBLIC_* variables
# (see frontend/.env.local.example).

# ---------------------------------------------------------------- containers
POSTGRES_USER=airecruiter
POSTGRES_PASSWORD=airecruiter
POSTGRES_DB=airecruiter
POSTGRES_PORT=5432
REDIS_PORT=6379
ADMINER_PORT=8081

# ------------------------------------------------------------------- backend
# Host-side URLs (from your machine): used by `uvicorn app.main:app` outside
# Docker, and by pytest. Inside compose the service names are substituted
# automatically (see docker-compose.yml), so this stays as it is.
DATABASE_URL=postgresql+asyncpg://airecruiter:airecruiter@localhost:5432/airecruiter
REDIS_URL=redis://localhost:6379/0

# The suite runs against DATABASE_URL's name with `_test` appended, created on
# demand — it never touches the workspace database.

# Connection pool. Big enough for the pipeline's per-stage workers plus traffic.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Log every SQL statement (loud; useful when a query looks wrong).
DB_ECHO=false

# ----------------------------------------------------------------- providers
# BRAVE_SEARCH_API_KEY is what searches the public web — nothing else has to
# change. Get a token at
# https://api-dashboard.search.brave.com (the free plan is enough to try it: one
# request per second, and one search fires one request per generated query).
# Empty means searches find no one. /health reports which stage is live.
BRAVE_SEARCH_API_KEY=
# SCRAPEGRAPH_API_KEY switches extraction from "read the search result" to "open
# the page and read it" — the profiles get their headline, bio, follower count and
# the links the person publishes, and one person found on two platforms becomes one
# lead. Get a key from the ScrapeGraphAI platform (sign in at
# https://scrapegraphai.com/login; the old dashboard.scrapegraphai.com is deprecated,
# and its keys are not accepted by the v2 API). Reading a page costs a credit, so
# every page is cached (SCRAPE_CACHE_TTL_HOURS below) and `GET /sources` reports which
# platforms actually let us in.
SCRAPEGRAPH_API_KEY=
# OpenAI reads the client's free-text search brief into criteria (one call per brief).
# Without a key, a rule-based reader recognises countries, languages, well-known brands
# and a lead count, and the review screen asks for the rest.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# With a key, every candidate is also judged against the search's requirements by a model
# (one call per candidate, gpt-4.1-mini by default); each "met" must quote the profile.
# false keeps the free keyword judge.
LLM_SIGNALS=true
OPENAI_JUDGE_MODEL=gpt-4.1-mini

# Optional providers behind the SearchProvider interface (spec §47).
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=
# "brave" — live as soon as the key above is set. "fixture" — never call out,
# whatever keys are configured.
SEARCH_PROVIDER=brave

# ------------------------------------------------- Brave Search (spec §28, §52)
# Endpoint is here so a test double or a proxy can take its place.
BRAVE_ENDPOINT=https://api.search.brave.com/res/v1/web/search
# Brave's own maximum per request is 20, and one query stays one billed call however
# many results it asks for — so anything below 20 is throwing away free candidates.
# A run at 10 turned 20 queries into 50 addresses and 14 candidates.
BRAVE_RESULTS_PER_QUERY=20
BRAVE_TIMEOUT_SECONDS=10
# Per *key*, not per search: every job in the process queues behind this. The
# free and Base plans allow 1/s — raise it with your plan, 0 disables the throttle.
BRAVE_RATE_LIMIT_PER_SECOND=1
# off | moderate | strict. The default filter can hide public profiles.
BRAVE_SAFESEARCH=off

# --------------------------------------------- ScrapeGraphAI (spec §33, §53) --
# The v2 Extract service (docs.scrapegraphai.com). Configuration rather than a
# constant because the legacy host is deprecated but still answers for older
# accounts: https://api.scrapegraphai.com/v1/smartscraper.
SCRAPEGRAPH_ENDPOINT=https://v2-api.scrapegraphai.com/api/extract
# Reading a page fetches, renders and extracts it — seconds, not milliseconds. Give
# it room: giving up early does not un-bill the request, so a short timeout pays for
# nothing. An Instagram profile can take a minute.
SCRAPEGRAPH_TIMEOUT_SECONDS=120
# Per *key*, like every provider limit here. Raise it with your plan.
SCRAPEGRAPH_RATE_LIMIT_PER_SECOND=1
# How many times one page may be read. One, deliberately: the service bills a
# request it served, so a retry pays for the same page again. MAX_RETRIES below is
# for calls that cost nothing to repeat, and stays separate for that reason.
SCRAPEGRAPH_READ_ATTEMPTS=1
# Fetch social profiles through ScrapeGraphAI's residential proxy, routed through
# the country being searched (fetchConfig.stealth + country + wait). On by default
# because the measurement was decisive: without it, 20 of 23 Instagram pages and 15
# of 15 Facebook pages came back 502/504 — a datacentre address is the request a
# social network is surest to refuse. It doubles the price of those pages; a
# personal website is still read the cheap way.
# Note on mode: the fetch mode stays "auto". Asking for "js" is documented and
# looks right for a JavaScript profile page, but on Instagram, Facebook and
# LinkedIn the service answers 400 fetch_provider_config and reads nothing at all.
# If a fetch config is ever refused, the reader drops it and asks plainly rather
# than giving up, so a bad key here can no longer end page reading for a run.
SCRAPEGRAPH_STEALTH=true
# How long to let a page settle after it loads (ms, max 30000). A profile is a
# JavaScript application: its bio is not in the first response.
SCRAPEGRAPH_PAGE_WAIT_MS=2000
# What one page costs in your plan's units. The v2 API reports no credits, so this
# is the only way the credit counter can be truthful: run a search, compare the
# dashboard, set the number to what actually moved. The documented price of an
# Extract call is 5, and the proxy adds 5 on top of it.
SCRAPEGRAPH_CREDITS_PER_PAGE=5
SCRAPEGRAPH_STEALTH_CREDITS=5
# Not every social URL can be scraped (Instagram shows a login wall to a server
# more often than not). true: fall back to the search result, so the lead survives
# with lower confidence. false: drop pages that will not open.
SCRAPEGRAPH_FALLBACK_TO_SNIPPETS=true

# --------------------------------- our own browser (Instagram, Facebook) --
# Public Instagram profiles and Facebook pages are read by a headless Chromium on
# this server (no login, no per-page cost) instead of ScrapeGraphAI, which timed
# out on almost all of them. LinkedIn stays with ScrapeGraphAI. Live search only.
BROWSER_READER=true
BROWSER_CONCURRENCY=4
BROWSER_TIMEOUT_SECONDS=15

# ------------------------------------------------------- limits (spec §52) --
SEARCH_CONCURRENCY=10
EXTRACTION_CONCURRENCY=10
LLM_CONCURRENCY=10
# For calls that cost nothing to repeat (a search query, a dropped socket). Paid
# page reads have their own attempt count above and are not affected by this.
MAX_RETRIES=3
# How long an extracted page may be reused (spec §53). A week: profiles change
# slowly and re-reading one costs a credit. 0 turns the cache off.
SCRAPE_CACHE_TTL_HOURS=168

# ------------------------------------- what one search may spend and aim for --
# The ceiling on *paid* page reads in one search. A live search finds 100+ candidate
# pages; reading all of them is the difference between cents and a plan's monthly
# credits. Candidates past the budget still become leads — from their search result,
# at lower confidence — so this costs depth, not coverage. Cache hits are free and
# never count against it. 0 means unlimited.
MAX_PAGES_PER_SEARCH=25
# "Find me this many leads." Reached, the search stops reading and stops judging;
# candidates are processed best-first, so what is dropped is the weakest tail.
# The wizard asks for this per search and prices it; this is only the default it
# starts from. 0 means "as many as there are".
TARGET_LEADS=0
# What one lead costs in paid pages. It is what turns "find me 10 leads" into a
# budget (10 × this, capped by MAX_PAGES_PER_SEARCH) and into the price the wizard
# quotes before anything runs. Not a constant to leave alone: a finished search
# reports pagesRead and leads, so set this to what your own runs measured.
PAGES_PER_LEAD=3
# The ceiling on generated queries, and so on billed search calls. One query is one
# call, and a search asked for in three languages writes three sets of them.
MAX_QUERIES_PER_SEARCH=96
# With a lead target, queries go out this many at a time: each wave is read and
# judged, and the next is sent only while the search is short of its target — up to
# MAX_QUERIES_PER_SEARCH in all. Without a target, every query goes out at once.
QUERIES_PER_WAVE=12
# A query whose page of results came back full is asked for its next page too, in a
# later wave, up to this many pages (the first included). Brave allows up to 10.
MAX_RESULT_PAGES=3

# ----------------------------------------------- cost model (spec §54) --
# What one unit costs, so the usage figures are money rather than counters.
# Brave's Base plan is $5/1000 requests; set the page price to what one paid read
# costs you (credits per page × your credit price).
COST_PER_SEARCH_CALL_EUR=0.005
COST_PER_PAGE_EUR=0.010
# Only charged while a detector that really calls an LLM is plugged in — the
# keyword stand-in is free, and pricing it put money on the screen nobody spent.
COST_PER_LLM_CALL_EUR=0.004

# ------------------------------------------------------ offline pacing only --
# The offline stand-ins answer instantly, so each pipeline step pauses this long
# to keep the progress screen watchable. Ignored once live search is on: Brave
# brings its own latency (about a second per query on the free plan).
PIPELINE_STEP_DELAY_MS=250

# Port the API is published on (backend service in docker-compose.yml).
BACKEND_PORT=8000
