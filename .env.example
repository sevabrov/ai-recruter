# AI Recruiter — server-side environment (spec §22)
#
# Copy to `.env` and fill in. This file is read by docker compose and, from
# Phase 2, by the FastAPI backend. NONE of these values may be exposed to the
# browser: the front end only ever sees NEXT_PUBLIC_* variables
# (see frontend/.env.local.example).

# ---------------------------------------------------------------- containers
POSTGRES_USER=airecruiter
POSTGRES_PASSWORD=airecruiter
POSTGRES_DB=airecruiter
POSTGRES_PORT=5432
REDIS_PORT=6379
ADMINER_PORT=8081

# ------------------------------------------------------------------- backend
# Host-side URLs (from your machine): used by `uvicorn app.main:app` outside
# Docker, and by pytest. Inside compose the service names are substituted
# automatically (see docker-compose.yml), so this stays as it is.
DATABASE_URL=postgresql+asyncpg://airecruiter:airecruiter@localhost:5432/airecruiter
REDIS_URL=redis://localhost:6379/0

# The suite runs against DATABASE_URL's name with `_test` appended, created on
# demand — it never touches the workspace database.

# Connection pool. Big enough for the pipeline's per-stage workers plus traffic.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Log every SQL statement (loud; useful when a query looks wrong).
DB_ECHO=false

# ----------------------------------------------------------------- providers
# BRAVE_SEARCH_API_KEY switches searching from the seeded catalogue to the live
# public web — nothing else has to change. Get a token at
# https://api-dashboard.search.brave.com (the free plan is enough to try it: one
# request per second, and one search fires one request per generated query).
# Empty means the demo keeps working offline. /health reports which stage is live.
BRAVE_SEARCH_API_KEY=
SCRAPEGRAPH_API_KEY=
OPENAI_API_KEY=

# Optional providers behind the SearchProvider interface (spec §47).
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=
# "brave" — live as soon as the key above is set. "fixture" — never call out,
# whatever keys are configured.
SEARCH_PROVIDER=brave

# ------------------------------------------------- Brave Search (spec §28, §52)
# Endpoint is here so a test double or a proxy can take its place.
BRAVE_ENDPOINT=https://api.search.brave.com/res/v1/web/search
# Brave's own maximum per request is 20, and one query stays one billed call.
BRAVE_RESULTS_PER_QUERY=20
BRAVE_TIMEOUT_SECONDS=10
# Per *key*, not per search: every job in the process queues behind this. The
# free and Base plans allow 1/s — raise it with your plan, 0 disables the throttle.
BRAVE_RATE_LIMIT_PER_SECOND=1
# off | moderate | strict. The default filter can hide public profiles.
BRAVE_SAFESEARCH=off

# ------------------------------------------------------- limits (spec §52) --
SEARCH_CONCURRENCY=10
EXTRACTION_CONCURRENCY=10
LLM_CONCURRENCY=10
MAX_RETRIES=3
SCRAPE_CACHE_TTL_HOURS=168

# --------------------------------------------------------- demo pacing only --
# The fixture adapters answer instantly, so each pipeline step pauses this long
# to keep the progress screen watchable. Ignored once live search is on: Brave
# brings its own latency (about a second per query on the free plan).
PIPELINE_STEP_DELAY_MS=250

# Port the API is published on (backend service in docker-compose.yml).
BACKEND_PORT=8000
